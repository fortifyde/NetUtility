# HP Aruba ArubaOS-Switch Configuration and Compliance Commands
# Special markers: @VERSION, @RUNNING_CONFIG, @RUNNING_CONFIG_ALL, @STARTUP_CONFIG
# All other commands are saved to compliance_commands.txt

# Version information
@VERSION show version

# Configuration files
@RUNNING_CONFIG show running-config
@STARTUP_CONFIG show config

# Running vs startup diff
show config status

# System information
show system

# Interface information
show interfaces brief
show interfaces

# Network information
show ip
show ip route

# Network discovery
show lldp info remote-device

# VLAN and switching
show vlans
show spanning-tree

# Additional compliance data
show arp
show mac-address
show cpu
show memory

# Security and Access Control
show port-security
show port-security ethernet all
show port-security intrusion-log
show access-list config

# AAA and Authentication
show aaa
show authentication

# SNMP Configuration
show snmp-server
show snmpv3 enable

# Logging and Monitoring
show logging

# DHCP Services
show dhcp-relay
show dhcp-snooping
show trunks

# Management and Security
show ip authorized-managers
show management
show front-panel-security

# Time and NTP
show time
show sntp
show sntp status

# Cryptographic Mechanisms (SSH/Telnet)
show ip ssh
show ssh
show crypto

# Login Banner
show banner

# Console and VTY Line Hardening
show console
show telnet
show web
show users

# AAA Authorization and Accounting
show radius
show tacacs
show accounting

# RBAC Roles and Local Accounts
show privilege
show password-policy

# IP Source Guard and Dynamic ARP Inspection
show arp-protect
show port-access

# VRRP (Redundancy)
show vrrp

# SNMP Configuration (v3)
show snmpv3

# Logging and Monitoring (Remote Syslog)
show syslog

# sFlow (Traffic Visibility)
show sflow
show sflow receiver

# DNS and Name Resolution
show ip dns
show dns