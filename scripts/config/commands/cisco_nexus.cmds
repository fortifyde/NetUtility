# Cisco Nexus NX-OS Configuration and Compliance Commands
# Special markers: @VERSION, @RUNNING_CONFIG, @RUNNING_CONFIG_ALL, @STARTUP_CONFIG
# All other commands are saved to compliance_commands.txt

# Version information
@VERSION show version

# Configuration files
@RUNNING_CONFIG show running-config
@RUNNING_CONFIG_ALL show running-config all
@STARTUP_CONFIG show startup-config

# Interface information
show interface status
show interface brief
show ip interface brief
show interface description

# Routing information
show ip route
show ip route summary

# Network discovery
show cdp neighbors detail
show lldp neighbors detail

# VLAN and switching
show vlan
show vlan brief
show spanning-tree summary

# VPC and port-channels
show vpc
show vpc brief
show port-channel summary

# System inventory
show inventory
show module

# Additional compliance data
show ip arp
show mac address-table
show system uptime
show processes cpu
show processes memory

# Security and Access Control
show port-security
show access-lists

# AAA and Authentication
show aaa
show aaa authentication

# SNMP Configuration
show snmp
show snmp community

# Logging and Monitoring
show logging

# DHCP Services
show ip dhcp snooping


# Cryptographic Mechanisms (SSH/Telnet)
show ssh server
show ssh key
show running-config | section ssh

# NTP Authentication and Time Synchronization
show ntp associations
show ntp authentication-status
show ntp source-interface
show clock

# Login Banner
show running-config | section banner

# Console and VTY Line Hardening
show terminal
show running-config | section line
show users

# AAA Authorization and Accounting
show aaa authorization
show accounting
show running-config | section aaa

# RBAC Roles and Local Accounts
show role
show running-config | section username
show running-config | section role

# Password Policy
show running-config | section password

# Login Enhancements (Brute-Force Protection)
show running-config | section login

# Feature Audit (Least Functionality)
show feature
show running-config | section feature

# Control Plane Policing (CoPP)
show copp policy
show copp status

# IP Source Guard and Dynamic ARP Inspection
show ip arp inspection
show ip verify source

# VPC Consistency (Fabric Security)
show vpc consistency-parameters

# NetFlow (Traffic Visibility)
show flow exporter
show flow monitor
show running-config | section sflow

# DNS and Name Resolution
show running-config | section ip domain