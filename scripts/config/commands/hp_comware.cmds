# HP Comware Configuration and Compliance Commands
# Special markers: @VERSION, @RUNNING_CONFIG, @RUNNING_CONFIG_ALL, @STARTUP_CONFIG
# All other commands are saved to compliance_commands.txt

# Version information
@VERSION display version

# Configuration files
@RUNNING_CONFIG display current-configuration
@RUNNING_CONFIG_ALL display current-configuration
@STARTUP_CONFIG display saved-configuration

# System information
display device
display device manuinfo

# Interface information
display interface brief
display ip interface brief
display interface description

# Routing information
display ip routing-table
display ip routing-table statistics

# Network discovery
display lldp neighbor-information

# VLAN and switching
display vlan all
display stp brief

# Additional compliance data
display arp
display mac-address
display cpu-usage
display memory

# Security and Access Control
display port-security
display acl all

# AAA and Authentication
display aaa

# SNMP Configuration
display snmp-agent
display snmp-agent community

# Logging and Monitoring
display logbuffer

# Stack Management
display stack

# Cryptographic Mechanisms (SSH/Telnet)
display ssh server status
display ssh server session
display telnet server
display public-key local rsa public

# NTP Authentication and Time Synchronization
display ntp-service status
display ntp-service sessions
display ntp-service authentication
display clock

# Login Banner
display header

# Console and VTY Line Hardening
display user-interface
display users

# AAA Authorization and Accounting
display aaa authorization
display accounting
display hwtacacs
display radius

# RBAC Roles and Local Accounts
display role
display password-policy
display local-user

# DHCP Snooping
display dhcp snooping binding
display dhcp snooping trusted
display dhcp snooping packet statistics

# IP Source Guard and Dynamic ARP Inspection
display ip source guard
display arp detection
display arp detection statistics

# VRRP (Redundancy)
display vrrp

# SNMP Configuration (v3)
display snmp-agent group
display snmp-agent usm-user

# Logging and Monitoring (Remote Syslog)
display info-center
display logbuffer summary

# IRF Stack and High Availability
display irf
display irf configuration
display irf topology

# Control Plane Policing / Rate Limiting
display cpu-defend policy
display cpu-defend statistics

# sFlow (Traffic Visibility)
display sflow

# DNS and Name Resolution
display dns server
display ip host

# Config Change Logging
display configuration commit