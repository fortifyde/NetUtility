# HP Aruba ArubaOS-CX Configuration and Compliance Commands
# Special markers: @VERSION, @RUNNING_CONFIG, @RUNNING_CONFIG_ALL, @STARTUP_CONFIG
# All other commands are saved to compliance_commands.txt

# Version information
@VERSION show version

# Configuration files
@RUNNING_CONFIG show running-config
@RUNNING_CONFIG_ALL show running-config all-properties
@STARTUP_CONFIG show startup-config

# System information
show system

# Interface information
show interface brief
show interface
show ip interface

# Routing information
show ip route
show ip route summary

# Network discovery
show lldp neighbor-info
show lldp neighbor-info detail

# VLAN and switching
show vlan
show spanning-tree

# VSX information
show vsx status
show vsx brief

# Additional compliance data
show arp
show mac-address-table
show system resource-utilization

# Security and Access Control
show port-security
show access-list

# AAA and Authentication
show aaa

# SNMP Configuration
show snmp

# Logging and Monitoring
show logging

# Time and NTP
show ntp status
show ntp associations
