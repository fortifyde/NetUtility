# Cisco IOS Configuration and Compliance Commands
# Special markers: @VERSION, @RUNNING_CONFIG, @RUNNING_CONFIG_ALL, @STARTUP_CONFIG
# All other commands are saved to compliance_commands.txt

# Version information
@VERSION show version

# Configuration files
@RUNNING_CONFIG show running-config
@RUNNING_CONFIG_ALL show running-config all
@STARTUP_CONFIG show startup-config

# Interface information
show interfaces
show ip interface brief
show interfaces status
show interfaces description

# Routing information
show ip route
show ip protocols

# Network discovery
show cdp neighbors detail
show lldp neighbors detail

# VLAN and switching
show vlan brief
show spanning-tree summary
show interfaces trunk

# System inventory
show inventory
show module

# Additional compliance data
show ip arp
show mac address-table
show version | include uptime
show processes cpu
show processes memory

# Security and Access Control
show port-security
show port-security address
show access-lists
show ip access-lists

# AAA and Authentication
show aaa
show aaa authentication
show aaa servers
show radius server detail
show tacacs-server detail

# HSRP/VRRP (Redundancy)
show standby all
show standby neighbors
show vrrp config

# VTP and Trunking
show vtp status
show vtp password
show interfaces switchport

# SNMP Configuration
show snmp
show snmp community
show snmp host

# Logging and Monitoring
show logging
show logging info

# Stack and High Availability
show stack
show udld

# DHCP Services
show ip dhcp snooping
show ip dhcp pool
show dhcp server


# Cryptographic Mechanisms (SSH/Telnet)
show ip ssh
show ssh
show running-config | section line
show running-config | section ssh
show crypto key mypubkey rsa

# NTP Authentication and Time Synchronization
show ntp associations
show ntp status
show ntp authentication
show clock

# Login Banner
show running-config | section banner

# Console and VTY Line Hardening
show line
show users

# AAA Authorization and Accounting
show aaa authorization
show accounting
show running-config | section aaa

# Privilege Levels and Local Accounts
show privilege
show running-config | section privilege
show running-config | section username

# Password Policy and Encryption
show running-config | section enable
show running-config | section service password

# Login Enhancements (Brute-Force Protection)
show login
show running-config | section login

# Config Archive and Change Logging
show archive
show archive log config all

# IP Source Guard and Dynamic ARP Inspection
show ip source binding
show ip verify source
show ip arp inspection
show ip arp inspection interfaces

# Control Plane Policing (DoS)
show control-plane host
show policy-map control-plane

# NetFlow (Traffic Visibility)
show flow exporter
show flow monitor
show flow record

# DNS and Name Resolution
show running-config | section ip dns
show hosts