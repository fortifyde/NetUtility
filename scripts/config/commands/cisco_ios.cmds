# Cisco IOS Configuration and Compliance Commands
# Special markers: @VERSION, @RUNNING_CONFIG, @RUNNING_CONFIG_ALL, @STARTUP_CONFIG
# All other commands are saved to compliance_commands.txt

# Version information
@VERSION show version

# Configuration files
@RUNNING_CONFIG show running-config
@RUNNING_CONFIG_ALL show running-config all
@STARTUP_CONFIG show startup-config

# Interface information
show interfaces
show ip interface brief
show interfaces status
show interfaces description

# Routing information
show ip route
show ip protocols

# Network discovery
show cdp neighbors detail
show lldp neighbors detail

# VLAN and switching
show vlan brief
show spanning-tree summary
show interfaces trunk

# System inventory
show inventory
show module

# Additional compliance data
show ip arp
show mac address-table
show version | include uptime
show processes cpu
show processes memory
