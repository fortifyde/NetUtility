# HP ProVision Configuration and Compliance Commands
# Special markers: @VERSION, @RUNNING_CONFIG, @RUNNING_CONFIG_ALL, @STARTUP_CONFIG
# All other commands are saved to compliance_commands.txt

# Version information
@VERSION show version

# Configuration files
@RUNNING_CONFIG show running-config
@RUNNING_CONFIG_ALL show config
@STARTUP_CONFIG show config

# System information
show system

# Interface information
show interfaces brief
show interfaces

# Network information
show ip
show ip route

# Network discovery
show lldp info remote-device

# VLAN and switching
show vlans
show spanning-tree

# Additional compliance data
show arp
show mac-address
show cpu
show memory
show uptime

# Security and Access Control
show port-security
show port-security ethernet all
show port-security intrusion-log
show access-list config

# AAA and Authentication
show aaa
show authentication
show password-configuration

# SNMP Configuration
show snmp-server
show snmpv3 enable

# Logging and Monitoring
show logging

# Stack and Management
show stack
show stack all
show front-panel-security
show management
show ip authorized-managers

# DHCP Services
show dhcp-relay
show dhcp-snooping
show ip helper-address

# VRRP and Trunks
show vrrp config
show trunks

# Time and NTP
show time
show sntp
show sntp status
show sntp associations
show sntp authentication

# Accounting
show accounting

# Cryptographic Mechanisms (SSH/Telnet)
show ip ssh
show ssh
show crypto

# Login Banner
show banner

# Console and VTY Line Hardening
show console
show telnet
show users

# DHCP Snooping Detail
show dhcp-snooping binding
show dhcpv6-snooping

# IP Source Guard and Dynamic ARP Inspection
show arp-protect
show source-filter

# SNMP Configuration (v3)
show snmpv3

# Logging and Monitoring (Remote Syslog)
show syslog

# sFlow (Traffic Visibility)
show sflow
show sflow receiver

# DNS and Name Resolution
show ip dns
show dns